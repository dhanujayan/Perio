# Copy to .env.local for local development. On Netlify, set these in
# Site configuration > Environment variables instead.

# Database.
# - On Netlify Database: leave DATABASE_URL unset; Netlify provides NETLIFY_DB_URL automatically.
# - Anywhere else (local, Neon, RDS): set DATABASE_URL.
DATABASE_URL="postgresql://perio:perio@localhost:5432/perio"

# Signs login sessions. Long random string, different per site. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Enables the one-time /setup page that creates the first admin account (12+ characters).
# Remove it after setup if you like; /setup closes itself once an admin exists.
SETUP_TOKEN=""

# Public address of the site (sitemap, links). On Netlify, defaults to the site URL.
SITE_URL="http://localhost:3000"

# Only for `npm test`: an EMPTY database; the tests wipe it.
TEST_DATABASE_URL="postgresql://perio:perio@localhost:5432/perio_test"
