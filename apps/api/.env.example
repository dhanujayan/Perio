# Copy to apps/api/.env
DATABASE_URL="postgresql://perio:perio@localhost:5432/perio?schema=public"

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

PORT=4000
# The public web origin (used for CORS and secure cookies)
WEB_ORIGIN="http://localhost:3000"
# Set to true behind HTTPS in production
COOKIE_SECURE=false

# First admin account, created by the seed script
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="Site Admin"

# An EMPTY database for `npm test` (every table in it is wiped before the run)
TEST_DATABASE_URL="postgresql://perio:perio@localhost:5432/perio_test?schema=public"
