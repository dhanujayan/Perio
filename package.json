{
  "name": "perio-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Periodontal knowledge and education platform — v1 (knowledge hub)",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "tsx scripts/prebuild.ts && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate && tsx scripts/sync-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
